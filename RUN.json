{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-e", "."]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "test": [
        ["${python}", "-m", "pytest", "-q"]
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "depends_on": ["db"],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "TEST_DATABASE_URL": { "dev": "${service:db.url}" }
      }
    }
  ]
}
